      "source": [
        "# 1. Importar librerías necesarias\n",
        "import yfinance as yf\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# 2. Descargar datos del S&P 500 (usamos el ETF SPY como proxy)\n",
        "print(\"Descargando datos del SPY...\")\n",
        "ticker = \"NDX\"\n",
        "datos = yf.download(ticker, start=\"2026-01-01\", end=\"2026-03-06\")\n",
        "\n",
        "# 3. Calcular métricas relevantes\n",
        "#    - Rendimiento diario (porcentaje de cambio)\n",
        "datos['Retorno'] = datos['Close'].pct_change() * 100\n",
        "\n",
        "#    - Media móvil y desviación estándar de los retornos (ventana de 30 días para el Z-Score)\n",
        "#      Esto será nuestro \"comportamiento normal\" de referencia.\n",
        "datos['Media_Retorno_30d'] = datos['Retorno'].rolling(window=30).mean()\n",
        "datos['Std_Retorno_30d'] = datos['Retorno'].rolling(window=30).std()\n",
        "\n",
        "# 4. Calcular el Z-Score para los retornos diarios\n",
        "#    Z = (Valor Actual - Media Histórica) / Desviación Histórica\n",
        "datos['ZScore_Retorno'] = (datos['Retorno'] - datos['Media_Retorno_30d']) / datos['Std_Retorno_30d']\n",
        "\n",
        "# 5. Definir el umbral de anomalía\n",
        "#    Un Z-Score de |3| es un evento muy poco probable en una distribución normal (99.7% de los datos caen dentro)\n",
        "UMBRAL_Z = 3.0\n",
        "\n",
        "# 6. Marcar las anomalías\n",
        "datos['Anomalia'] = np.abs(datos['ZScore_Retorno']) > UMBRAL_Z\n",
        "\n",
        "# 7. Mostrar los resultados\n",
        "print(\"\\n--- Últimas 10 filas del análisis ---\")\n",
        "print(datos[['Retorno', 'Media_Retorno_30d', 'Std_Retorno_30d', 'ZScore_Retorno', 'Anomalia']].tail(10))\n",
        "\n",
        "print(f\"\\n--- Días con anomalías (Z-Score > |{UMBRAL_Z}|) ---\")\n",
        "anomalias = datos[datos['Anomalia'] == True]\n",
        "print(anomalias[['Retorno', 'ZScore_Retorno']])\n",
        "\n",
        "# 8. Visualizar (la parte más importante para entender)\n",
        "plt.figure(figsize=(14,7))\n",
        "\n",
        "# Gráfico 1: Precio del SPY\n",
        "plt.subplot(2, 1, 1)\n",
        "plt.plot(datos.index, datos['Close'], label='Precio de Cierre NDX', color='blue')\n",
        "plt.title('Precio del NDX y Anomalías Detectadas')\n",
        "plt.ylabel('Precio ($)')\n",
        "plt.legend()\n",
        "\n",
        "# Resaltar los puntos anómalos en el gráfico de precio\n",
        "fechas_anomalias = anomalias.index\n",
        "precios_anomalias = datos.loc[fechas_anomalias, 'Close']\n",
        "plt.scatter(fechas_anomalias, precios_anomalias, color='red', label='Día Anómalo', zorder=5)\n",
        "plt.legend()\n",
        "\n",
        "# Gráfico 2: Z-Score de los Retornos\n",
        "plt.subplot(2, 1, 2)\n",
        "plt.plot(datos.index, datos['ZScore_Retorno'], label='Z-Score del Retorno Diario', color='green')\n",
        "plt.axhline(y=UMBRAL_Z, color='red', linestyle='--', label=f'Umbral +{UMBRAL_Z}')\n",
        "plt.axhline(y=-UMBRAL_Z, color='red', linestyle='--', label=f'Umbral -{UMBRAL_Z}')\n",
        "plt.axhline(y=0, color='black', linestyle='-', linewidth=0.5)\n",
        "plt.title('Z-Score del Retorno Diario (Ventana 30 días)')\n",
        "plt.ylabel('Z-Score')\n",
        "plt.xlabel('Fecha')\n",
        "plt.legend()\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
